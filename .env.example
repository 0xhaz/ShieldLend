# ============================================================
# ShieldLend — Environment Configuration
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file — it's in .gitignore.
# ============================================================

# ---- Starknet Account ----
# Your deployer account address (felt252 hex)
STARKNET_ACCOUNT_ADDRESS=0x_YOUR_ACCOUNT_ADDRESS

# Path to your sncast account file (created by `sncast account create`)
# Default: ~/.starknet_accounts/starknet_open_zeppelin_accounts.json
STARKNET_ACCOUNT_FILE=~/.starknet_accounts/starknet_open_zeppelin_accounts.json

# Account name in the accounts file
STARKNET_ACCOUNT_NAME=deployer

# ---- Network ----
# "sepolia" or "devnet"
STARKNET_NETWORK=sepolia

# RPC URL (leave empty to use default for the network)
# Sepolia default: https://starknet-sepolia.public.blastapi.io/rpc/v0_7
# Devnet default:  http://localhost:5050/rpc
STARKNET_RPC_URL=

# ---- Deployed Contract Addresses ----
# Fill these in AFTER running the deployment script.
# The deploy script will output these addresses.

# Core
MARKET_FACTORY_ADDRESS=0x0
LENDING_POOL_ADDRESS=0x0
FLASH_LOAN_VAULT_ADDRESS=0x0

# Tokens
SL_TOKEN_ADDRESS=0x0
DEBT_TOKEN_ADDRESS=0x0

# Interest
INTEREST_RATE_MODEL_ADDRESS=0x0

# Oracle
ORACLE_ADDRESS=0x0

# Privacy
COMMITMENT_STORE_ADDRESS=0x0
NULLIFIER_REGISTRY_ADDRESS=0x0
ZK_VERIFIER_ADDRESS=0x0
SHIELDED_ACCOUNT_ADDRESS=0x0

# Liquidation
LIQUIDATION_ENGINE_ADDRESS=0x0
AUCTION_ADDRESS=0x0

# Yield
YIELD_TOKENIZER_ADDRESS=0x0
PRINCIPAL_TOKEN_ADDRESS=0x0
YIELD_TOKEN_ADDRESS=0x0

# ---- External Token Addresses (Sepolia testnet) ----
# These are the actual ERC20 tokens used as collateral/loan assets.
# On Sepolia, you can deploy mock ERC20s or use existing test tokens.
STRK_BTC_TOKEN=0x0
TBTC_TOKEN=0x0
USDC_TOKEN=0x0
