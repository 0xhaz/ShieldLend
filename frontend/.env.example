# ============================================================
# ShieldLend Frontend — Environment Configuration
# ============================================================
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# ============================================================

# ---- Starknet Network ----
NEXT_PUBLIC_STARKNET_NETWORK=sepolia

# RPC URL (optional — uses public provider if not set)
NEXT_PUBLIC_RPC_URL=

# ---- Deployed Contract Addresses ----
# Fill these after running scripts/deploy.sh

# Core
NEXT_PUBLIC_MARKET_FACTORY=0x0
NEXT_PUBLIC_FLASH_LOAN_VAULT=0x0

# Oracle
NEXT_PUBLIC_ORACLE=0x0

# Privacy
NEXT_PUBLIC_COMMITMENT_STORE=0x0
NEXT_PUBLIC_NULLIFIER_REGISTRY=0x0
NEXT_PUBLIC_ZK_VERIFIER=0x0

# Liquidation
NEXT_PUBLIC_LIQUIDATION_ENGINE=0x0
NEXT_PUBLIC_AUCTION=0x0

# ---- Token Addresses ----
# Fill after running scripts/deploy_markets.sh
NEXT_PUBLIC_STRK_BTC=0x0
NEXT_PUBLIC_TBTC=0x0
NEXT_PUBLIC_USDC=0x0

# ---- Market Pool Addresses ----
# Fill after running scripts/deploy_markets.sh
NEXT_PUBLIC_POOL_STRKBTC_USDC=0x0
NEXT_PUBLIC_POOL_TBTC_USDC=0x0
NEXT_PUBLIC_POOL_STRKBTC_TBTC=0x0
